# Servidor
PORT=3000
NODE_ENV=development

# MongoDB Atlas: Database → Connect → Drivers
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=catalogo

# Seguridad
# Cadena aleatoria de 32+ caracteres
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Genera el hash con: pnpm hash-password "tu-contraseña"
ADMIN_PASSWORD_HASH=

# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Intentos de login permitidos por IP y ventana de tiempo
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW=15 minutes

# Imágenes (opcional). Sin estas variables las fotos se guardan en MongoDB.
# Cloudinary → Settings (engrane) → API Keys. Las tres van juntas.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta dentro de Cloudinary donde se guardan las fotos
CLOUDINARY_FOLDER=catalogo

# Pedidos por Telegram (opcional). Sin estas variables los pedidos se guardan igual
# y se envían en cuanto las configures (los de las últimas 24 h).
# 1) En Telegram habla con @BotFather → /newbot → copia el token.
# 2) Escríbele cualquier cosa a tu bot (o agrégalo a un grupo) y abre
#    https://api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id": …} es el CHAT_ID
#    (en grupos es negativo, ej. -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pedidos permitidos por IP y ventana de tiempo (contra abuso)
ORDER_MAX_PER_WINDOW=10
ORDER_WINDOW=10 minutes

# Pedidos por correo (opcional). Opción 1 — Gmail (sin dominio propio, escribe a cualquier cliente):
#   activa la verificación en 2 pasos y crea una contraseña de aplicación en
#   https://myaccount.google.com/apppasswords (16 letras). EMAIL_FROM debe ser esa misma cuenta.
GMAIL_APP_PASSWORD=
# Opción 2 — Resend (resend.com), requiere dominio verificado para escribir a clientes:
RESEND_API_KEY=
# Mientras no verifiques tu dominio: onboarding@resend.dev
EMAIL_FROM=
# Correo(s) del negocio que reciben los pedidos (separados por coma)
EMAIL_ORDERS_TO=
